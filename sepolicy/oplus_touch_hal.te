# ktm (Ace 6): complete the ROM oplus touch HAL types in the recovery policy.
#
# When recovery mounts the device ODM partition, init loads its own
# precompiled_file_contexts; the hbp5 service binary matches the ROM rule
#
#   /(vendor|odm)/bin/hw/vendor-oplus-hardware-touch-V2-hbp5-service
#       u:object_r:hal_oplus_touch_aidl_default_exec:s0
#
# whose type is absent from the recovery policy, so the label resolves to
# nothing and init's seclabel audit refuses to start the service. Define
# the ROM type names here, add the transition from the init-family
# domains, and mark the domain permissive so the daemon's accesses are
# logged rather than blocked while every other domain stays enforcing.

type hal_oplus_touch_aidl_default_exec, exec_type, file_type, vendor_file_type;
type hal_oplus_touch_aidl_default, domain;
permissive hal_oplus_touch_aidl_default;

type_transition init hal_oplus_touch_aidl_default_exec : process hal_oplus_touch_aidl_default;
type_transition recovery hal_oplus_touch_aidl_default_exec : process hal_oplus_touch_aidl_default;
type_transition vendor_init hal_oplus_touch_aidl_default_exec : process hal_oplus_touch_aidl_default;
