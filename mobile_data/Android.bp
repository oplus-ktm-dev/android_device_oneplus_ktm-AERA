package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

license {
    name: "aera_ktm_cn_nv_proprietary",
    visibility: [":__subpackages__"],
    license_kinds: ["legacy_proprietary"],
    license_text: ["firmware/23821/NOTICE"],
}

prebuilt_etc {
    name: "aera-ktm-cn-static-nv",
    recovery: true,
    src: "firmware/23821/oplusstanvbk.img",
    filename: "oplusstanvbk.img",
    sub_dir: "aera/mobile/23821",
    licenses: ["aera_ktm_cn_nv_proprietary"],
}

cc_binary {
    name: "aera-cellular-provider",
    recovery: true,
    srcs: ["daemon.cpp"],
    include_dirs: ["bootable/recovery"],
    cpp_std: "c++17",
    rtti: false,
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    static_libs: ["libjsoncpp"],
    shared_libs: ["libcutils", "libcrypto", "libtinyxml2"],
    required: ["aera-mobile-rmtfs", "aera-mobile-tftp", "aera-ktm-cn-static-nv"],
}

cc_binary {
    name: "aera-mobile-rmtfs",
    recovery: true,
    stl: "none",
    srcs: [":aera_rmtfs_sources", "sharedmem-uio.c", "readonly-guard.c"],
    static_libs: ["libaera_qrtr"],
    header_libs: ["aera_rmtfs_headers"],
    cflags: ["-D_GNU_SOURCE", "-Wno-unused-parameter"],
    ldflags: ["-Wl,--wrap=open,--wrap=openat,--wrap=__open_2,--wrap=__openat_2,--wrap=pwrite,--wrap=storage_init,--wrap=storage_open,--wrap=storage_close,--wrap=storage_pread"],
}

cc_binary {
    name: "aera-mobile-tftp",
    recovery: true,
    stl: "none",
    srcs: [":aera_tqftpserv_sources", "translate-safe.c"],
    static_libs: ["libaera_qrtr"],
    header_libs: ["aera_tqftpserv_headers"],
    cflags: ["-D_GNU_SOURCE", "-Wno-unused-parameter"],
}
