# Only AERA requests authentication after storage and its modules are ready.
# Vendor init cannot watch the private platform post.decrypt.modules property.
service aera-fingerprint-prepare /system/bin/sh /vendor/bin/aera-fingerprint-prepare
    class hal
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

# The ultrasonic fingerprint HAL uses IOplusTouch to enable sensor touch routing.
# Start only after decryption/preparation, before fingerprint authentication.
# Keep the HBP touch processor alive across lock/unlock. Recovery's dynamic
# partition quiesce stops this init service before releasing its ODM firmware.
service touchDaemon /vendor/bin/touchDaemon
    class hal
    disabled
    user root
    group root system input inet misc media_rw sdcard_rw sdcard_r radio
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64

service vendor.touch-aidl-1 /vendor/bin/hw/vendor-oplus-hardware-touch-V2-hbp5-service
    class hal
    disabled
    user root
    group root system input inet
    capabilities SYS_NICE
    socket hidl2touchdaemon_client dgram 0660 root inet
    socket hidl2touchdaemon_server dgram 0660 root inet
    interface aidl vendor.oplus.hardware.touch.IOplusTouch/default
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64

service aera-fingerprint-hal /vendor/bin/hw/vendor.oplus.hardware.biometrics.fingerprint@2.1-service_uff
    class hal
    disabled
    user system
    group system input uhid
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64:/vendor/odm/lib64

on property:vendor.aera.fingerprint.start=1
    setprop vendor.aera.fingerprint.ready 0
    start aera-fingerprint-prepare

on property:vendor.aera.fingerprint.ready=1 && property:vendor.aera.fingerprint.start=1
    start touchDaemon
    start vendor.touch-aidl-1
    start aera-fingerprint-hal

on property:vendor.aera.fingerprint.start=0
    setprop vendor.aera.fingerprint.ready 0
    stop aera-fingerprint-prepare
    stop aera-fingerprint-hal
    stop vendor.touch-aidl-1
